{
  "name": "instapilot",
  "version": "0.1.0",
  "description": "Generatore AI white-label di carousel e post Instagram: ricerca, narrativa, design e rendering in un'unica pipeline.",
  "keywords": [
    "instagram",
    "carousel",
    "ai",
    "llm",
    "content-generation",
    "white-label",
    "playwright",
    "remotion",
    "openai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CesareIsHere/instapilot"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "studio": "remotion studio src/remotion/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.0",
    "multer": "^2.2.0",
    "openai": "^6.39.0",
    "playwright": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "sucrase": "^3.35.1",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/pixelmatch": "^5.2.0",
    "@types/pngjs": "^6.0.0",
    "@types/react": "^18.3.0",
    "@types/supertest": "^6.0.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
