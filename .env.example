# ── Instapilot — example configuration ────────────────────────────────────────
# Copy to .env and fill in the variables you need.
# Most values can also be set from the UI (Settings / Brand Kit).

PORT=3001
OUTPUT_DIR=./output
LOG_LEVEL=info

# ── LLM provider ──────────────────────────────────────────────────────────────
# Option A: OpenAI directly
# The API key can also be set from the UI (Settings → API key).
# If set both here and in the UI, the UI wins.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o                 # default: gpt-4o
# OPENAI_REASONING_EFFORT=medium      # minimal|low|medium|high

# Option B: LiteLLM proxy / any OpenAI-compatible endpoint (overrides option A when set)
# LITELLM_BASE_URL=http://localhost:4000
# LITELLM_API_KEY=sk-changeme
# LITELLM_MODEL=claude-sonnet-4-6

# ── Local data paths (advanced) ───────────────────────────────────────────────
# APP_CONFIG_FILE=./data/config.json   # LLM config saved from the UI
# BRAND_KIT_FILE=./data/brand-kit.json # brand kit saved from the UI

# ── Brand context ─────────────────────────────────────────────────────────────
# Brand document injected into the generation prompts (fallback used when no
# Brand Kit has been saved from the UI). Point it at your own document: see
# docs/brand-context.example.md for the template, or examples/brand-contexts/productivity.md
# for a filled-in example (fictional brand).
BRAND_CONTEXT_FILE=docs/brand-context.example.md

# Footer primitive defaults (brand handle + optional disclaimer)
# BRAND_HANDLE=@yourbrand
# BRAND_DISCLAIMER=Informational/educational content.

# ── HTML rendering (POST /render/html) ────────────────────────────────────────
# Requires: npm install && npx playwright install chromium
# HTML_MAX_DESIGN_RETRIES=3        # design retries when the critic rejects it (default: 3)
# HTML_MAX_ATTEMPTS=5              # retries on overflow / quality review (default: 5)
# HTML_RENDER_TIMEOUT_MS=15000     # Playwright render timeout (default: 15000)
# HTML_DEVICE_SCALE_FACTOR=1       # 1=1080x1350, 2=2160x2700 (default: 1)

# ── Content generation (POST /generate/content) ───────────────────────────────
# CONTENT_MAX_RESEARCH_ROUNDS=2    # dossier review rounds (default: 2)
# CONTENT_MAX_PLAN_ROUNDS=2        # plan review rounds (default: 2)
# CONTENT_MAX_REVIEW_ROUNDS=2      # editorial review rounds (default: 2)
# OPENAI_WEB_SEARCH_TOOL=web_search_preview

# ── Per-agent model (falls back to OPENAI_MODEL when unset) ───────────────────
# MODEL_RESEARCH=gpt-4o
# MODEL_RESEARCH_REVIEW=gpt-4o-mini
# MODEL_PLAN=gpt-4o
# MODEL_PLAN_REVIEW=gpt-4o-mini
# MODEL_DESIGN_PLAN=gpt-4o
# MODEL_DESIGN_REVIEW=gpt-4o-mini
# MODEL_HTML_RENDER=gpt-4o
# MODEL_QUALITY_REVIEW=gpt-4o
# MODEL_EDITORIAL_REVIEW=gpt-4o-mini
# MODEL_DYNAMIC=gpt-4o

# ── Cost estimate ─────────────────────────────────────────────────────────────
# LLM_PRICE_INPUT_PER_1M=2.5
# LLM_PRICE_OUTPUT_PER_1M=10
# LLM_PRICE_CURRENCY=USD
