PORT=3001
OUTPUT_DIR=./output
LOG_LEVEL=info

# Dynamic render mode — opzione A: OpenAI diretto
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o                 # default: gpt-4o
# OPENAI_REASONING_EFFORT=high        # minimal|low|medium|high (solo modelli reasoning: gpt-5, o4-mini, o3, ...)

# Dynamic render mode — opzione B: litellm proxy (override A se presenti)
# LITELLM_BASE_URL=http://localhost:4000
# LITELLM_API_KEY=sk-changeme
# LITELLM_MODEL=claude-sonnet-4-6

BRAND_CONTEXT_FILE=docs/contesto-progetto-finvestire.md

# HTML render mode (POST /render/html) — richiede: npm install && npx playwright install chromium
# Pipeline a 4 agenti: 1) design planner → 2) design critic → 3) renderer → 4) quality reviewer
# HTML_MAX_DESIGN_RETRIES=3        # retry sul design se l'agente 2 lo boccia (default: 3)
# HTML_MAX_ATTEMPTS=5               # retry su overflow / quality review (default: 5)
# HTML_RENDER_TIMEOUT_MS=15000      # timeout render Playwright (default: 15000)
# HTML_DEVICE_SCALE_FACTOR=1        # 1=1080x1350, 2=2160x2700 (default: 1)
# PLAYWRIGHT_BROWSERS_PATH=~/.cache/ms-playwright

# Content generation (POST /generate/content) — pipeline end-to-end
# 1) researcher (web search OpenAI) → 2) content planner → 3) slide pipeline x N → 4) revisione editoriale
# CONTENT_MAX_RESEARCH_ROUNDS=2     # giri di revisione del dossier di ricerca (default: 2)
# CONTENT_MAX_PLAN_ROUNDS=2         # giri di revisione del piano contenuti (default: 2)
# CONTENT_MAX_REVIEW_ROUNDS=2       # giri di revisione editoriale finale (default: 2)
# OPENAI_WEB_SEARCH_TOOL=web_search_preview  # tool web search Responses API (default: web_search_preview)
